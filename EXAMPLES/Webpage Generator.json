      "label": "Chat Generator",
      "data": {
        "max_length": 1024,
        "max_context_length": 2048,
        "_output": {
          "role": "assistant",
          "content": "```html\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Gratitude Journal</title>\n    <style>\n        body { font-family: 'Segoe UI', sans-serif; background: #fdf6e3; display: flex; justify-content: center; padding: 20px; }\n        .card { background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }\n        h2 { color: #856404; text-align: center; }\n        .input-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }\n        input { padding: 10px; border: 1px solid #ddd; border-radius: 5px; outline: none; }\n        button { padding: 10px; background: #d4a373; border: none; color: white; border-radius: 5px; cursor: pointer; font-weight: bold; }\n        button:hover { background: #bc8a5f; }\n        #list { max-height: 300px; overflow-y: auto; margin-top: 20px; }\n        .entry { background: #faedcd; padding: 10px; margin-bottom: 10px; border-radius: 8px; border-left: 5px solid #d4a373; animation: fadeIn 0.3s; }\n        .date { font-size: 0.8rem; color: #666; display: block; margin-bottom: 5px; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n    </style>\n</head>\n<body>\n    <div class=\"card\">\n        <h2>✨ Daily Gratitude</h2>\n        <div class=\"input-group\">\n            <input type=\"text\" id=\"i1\" placeholder=\"Thing 1...\">\n            <input type=\"text\" id=\"i2\" placeholder=\"Thing 2...\">\n            <input type=\"text\" id=\"i3\" placeholder=\"Thing 3...\">\n            <button onclick=\"save()\">Save Entry</button>\n        </div>\n        <div id=\"list\"></div>\n    </div>\n\n    <script>\n        function save() {\n            const entries = JSON.parse(localStorage.getItem('gratitude') || '[]');\n            const day = new Date().toLocaleDateString();\n            const texts = [document.getElementById('i1').value, document.getElementById('i2').value, document.getElementById('i3').value];\n            if (!texts[0] || !texts[1] || !texts[2]) return alert('Please fill all three!');\n            entries.unshift({ date: day, items: texts });\n            localStorage.setItem('gratitude', JSON.stringify(entries));\n            render();\n            ['i1','i2','i3'].forEach(id => document.getElementById(id).value = '');\n        }\n        function render() {\n            const entries = JSON.parse(localStorage.getItem('gratitude') || '[]');\n            document.getElementById('list').innerHTML = entries.map(e => `\n                <div class=\"entry\"><span class=\"date\">${e.date}</span>${e.items.join('<br>')}</div>\n            `).join('');\n        }\n        render();\n    </script>\n</body>\n</html>\n```"
        }
      }
